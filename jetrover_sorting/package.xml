<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jetrover_sorting</name>
  <version>0.1.0</version>
  <description>Reworked colour sorting for the HiWonder JetRover: explicit state machine, pick logging, swappable detector.</description>
  <maintainer email="fuzesa@users.noreply.github.com">fuzesa</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>interfaces</exec_depend>
  <exec_depend>servo_controller</exec_depend>
  <exec_depend>servo_controller_msgs</exec_depend>
  <exec_depend>kinematics</exec_depend>
  <exec_depend>kinematics_msgs</exec_depend>
  <!-- launch-time only: vendor bring-up and the colour detector -->
  <exec_depend>controller</exec_depend>
  <exec_depend>peripherals</exec_depend>
  <exec_depend>example</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
